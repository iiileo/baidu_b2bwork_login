API_TOKEN=dev-token-change-me
WEBHOOK_SECRET=dev-webhook-secret-change-me

# 控制台表单登录（留空用户或密码则关闭，仅 Bearer）
CONSOLE_USER=admin
CONSOLE_PASSWORD=admin
# Cookie 签名密钥（可选；默认回退 WEBHOOK_SECRET）
# SESSION_SECRET=

QUEUE_DB_PATH=./data/queue.db
DATA_DIR=./data

PLAYWRIGHT_BROWSER=chromium
PLAYWRIGHT_HEADLESS=true
ENABLE_VNC=true
VNC_PAGE_URL=/vnc/vnc.html?autoconnect=true&resize=scale&path=vnc/websockify
VNC_UPSTREAM=http://127.0.0.1:7900
CAPTCHA_WAIT_SECONDS=300
SECURITY_WAIT_SECONDS=300

API_HOST=0.0.0.0
API_PORT=8056

# 慢速模拟（docker compose；网速需 NET_ADMIN）
# CPU_LIMIT=1.0
# NET_RATE=2mbit
# NET_DELAY=100ms
# NET_LOSS=1%
# 关闭限速：NET_RATE=off
# 关闭 CPU 限制：CPU_LIMIT=0（部分 Docker 版本需去掉 compose 里的 cpus）
